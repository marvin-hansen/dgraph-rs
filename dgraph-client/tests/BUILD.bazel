load("@crates//:defs.bzl", "all_crate_deps")
load("@rules_rs//rs:rust_test.bzl", "rust_test")

# `rust_test`, not `rust_test_suite`: the suite macro generates one test per source file and sets
# `crate_root` itself, so passing `crate_root` fails the whole package.

DEV_DEPS = all_crate_deps(
    cargo_only = True,
    normal = True,
    normal_dev = True,
    package_name = "dgraph-client",
)

# The client's own unit tests: types, parsing and error mapping. No fixture, no infrastructure,
# so this is untagged and runs everywhere -- and it links the library as a CONSUMER gets it,
# which is what makes it a test of the shipped crate rather than of a feature-enabled variant.
rust_test(
    name = "dgraph_client_unit_test",
    srcs = glob(
        ["**/*.rs"],
        exclude = [
            "dgraph_container_test.rs",
            "utils_test_tests.rs",
            "utils_test/**",
        ],
    ),
    crate_root = "lib_tests.rs",
    deps = DEV_DEPS + [
        "//dgraph-client:dgraph_client",
        "//proto/dgraph:proto_dgraph_bindings",
    ],
)

# The fixture's own unit tests: the strategy branch, the endpoint contract, the health report
# parser and the error surface. Still pure logic -- no Docker, no network -- so it is untagged
# too; only the code under test needs the feature.
rust_test(
    name = "dgraph_client_utils_test",
    srcs = glob([
        "utils_test_tests.rs",
        "utils_test/**/*.rs",
    ]),
    crate_root = "utils_test_tests.rs",
    deps = DEV_DEPS + [
        "//dgraph-client:dgraph_client_test_utils",
        "//proto/dgraph:proto_dgraph_bindings",
    ],
)

# Needs a running Dgraph: starts a dgraph/standalone container and drives the real client against
# it. Every scenario shares that one instance and several are destructive, so they are sequenced
# inside a single test function -- Bazel runs test functions concurrently and does not honour
# --test-threads=1. See the module docs in dgraph_container_test.rs.
#
#   bazel test --test_tag_filters=integration_test \
#     //dgraph-client/tests:dgraph_client_integration_test
rust_test(
    name = "dgraph_client_integration_test",
    srcs = ["dgraph_container_test.rs"],
    # The Cargo-side half of the same "needs infrastructure" fact the tag states to Bazel: the
    # test is #[ignore] so `cargo test` stays hermetic. Bazel runs the same binary and would
    # honour that too, reporting green having run nothing.
    args = ["--include-ignored"],
    crate_root = "dgraph_container_test.rs",
    tags = [
        # Excluded by a plain `bazel test //...` when the caller passes
        # --test_tag_filters=-integration_test, and selected on its own with
        # --test_tag_filters=integration_test.
        "integration_test",
    ],
    visibility = ["//visibility:public"],
    deps = DEV_DEPS + [
        "//dgraph-client:dgraph_client_test_utils",
        "//proto/dgraph:proto_dgraph_bindings",
    ],
)
